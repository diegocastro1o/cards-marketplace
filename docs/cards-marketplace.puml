@startuml
abstract class Transaction {
    - operation_id : str
    - type : str
    - ocurred_at : str
}
class pack_opening {
    - user_id : int
    - pack_type : str



}


class Market {
    - users: list[User]
    - listings : list[MarketListing]
    - catalog : list[Card]
    - packs : list[Pack]
    -transactions : list[Transaction]




}
class User {
    - user_id : int
    - user_name: str
    - balance: int
    - inventory: list[Card]

    + get_balance(): int
    + debit(amount: int): None
    + credit(amount: int): None
    + has_card(card: Card): bool
    + add_card(card: Card): None
    + remove_card(card: Card): None
    + open_pack(pack_type: str) : None
}
class CardDrawer {
    + draw_card(catalog,weight): Card


}

abstract class Pack {
    - type : str
    - price: int
    - card_count: int
    - rarity_weights: dict

    + purchase(buyer: User): None
    + open():
    + generate_cards(): list[Card]
}
class BronzePack{
    -card_count : int
    -price : int

}
class SilverPack{
    -card_count : int
    -price : int

}
class GoldPack{
    -card_count : int
    -price : int

}


class MarketListing {
    - card: Card
    - seller: User
    - price: int

    + purchase(buyer: User): None
}

class Card {
    - card_id: int
    - full_name: str
    - position: PlayerPosition
    - trait: CardTrait | None
    - rarity: CardRarity
}

enum CardRarity {
    COMMON
    RARE
    EXCEPTIONAL
    ELITE
    MASTERCLASS
    LEGENDARY
}

enum PlayerPosition {
    GOALKEEPER
    DEFENDER
    MIDFIELDER
    FORWARD
}

enum CardTrait {
    ONE_ABOVE_ALL
    TEAM_OF_THE_CHAMPIONS
    UNRIVALED
    THE_CHOSEN_ONE
    BORN_TO_LEAD
    A_CLASS_APART
    NET_BREAKER
    PLAYMAKER
    DEFENSE_MASTER
    NET_GUARDIAN
    HEART_OF_THE_TEAM
    ARMBAND_BEARER
    LEADER_OF_MANY
}

User "1" - "0..*" Card : tiene
User "1" -- "0..*" MarketListing : publica

Card "1" -- "0..1" MarketListing : es ofrecida

Card ..> CardRarity
Card ..> PlayerPosition
Card ..> CardTrait

Pack ..> User : cobra
Pack ..> Card : genera
pack_opening --|> Transaction
BronzePack --|> Pack
SilverPack --|> Pack
GoldPack --|> Pack
@enduml
